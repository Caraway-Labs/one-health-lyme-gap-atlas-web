{
  "name": "one-health-lyme-gap-atlas-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "playwright test --config playwright.storybook.config.ts --project=desktop",
    "test:storybook:mobile": "node scripts/run-playwright-mobile.mjs --storybook",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "docs:api": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts-extension.mjs src/lib/public-openapi-reference.ts",
    "docs:api:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts-extension.mjs src/lib/public-openapi-reference.ts --check",
    "docs:api:drift": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts-extension.mjs src/lib/public-openapi-reference.ts --drift",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:generate": "fumadocs-mdx",
    "lint": "ultracite check",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:ux-reset": "node scripts/check-ux-reset-constitution.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "generate:api": "orval --config orval.config.ts",
    "generate:front-porch-county": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-front-porch-montgomery-outline.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:mobile": "node scripts/run-playwright-mobile.mjs",
    "format": "ultracite fix",
    "postinstall": "npm run docs:generate",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && npm run docs:api:check && npm run docs:generate && npm run docs:check",
    "predev": "node scripts/copy-maplibre-worker.mjs && npm run docs:api:check",
    "pretypecheck": "npm run docs:api:check && npm run docs:generate && npm run docs:check"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "2.45.8",
    "@base-ui/react": "^1.7.0",
    "@caraway-labs/one-health-lyme-gap-atlas-knowledge-graph": "git+https://github.com/Caraway-Labs/one-health-lyme-gap-atlas-knowledge-graph.git#kg-v1.0.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.10",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^12.5.2",
    "fumadocs-ui": "^16.15.10",
    "lucide-react": "^1.35.0",
    "maplibre-gl": "6.4.1",
    "mdast-util-directive": "^3.1.0",
    "next": "16.4.1",
    "nuqs": "^2.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.0",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "braces": "file:vendor/braces",
    "jsdom": "^26.0.0",
    "orval": "^8.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "^1.80.0",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "ultracite": "7.10.7",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "braces": "$braces",
    "fast-uri": "3.1.9",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "orval": {
      "js-yaml": "4.3.2"
    },
    "undici": "7.30.1",
    "zod": "$zod"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
